PORT=5000
CLIENT_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata
DATABASE_URL=postgresql://username:password@host:port/database

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# Only used by `npm run seed:demo`; set this to your existing account email.
SEED_USER_EMAIL=your-existing-account@example.com

# Required only for the explicit fictional doctor seed command.
# Set both values locally; never commit the real password.
ENABLE_DEMO_DOCTOR_SEED=false
DEMO_DOCTOR_PASSWORD=replace_with_a_unique_secure_demo_password
